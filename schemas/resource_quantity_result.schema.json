{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivum.local/schemas/resource_quantity_result.schema.json",
  "title": "VIVUM Resource Quantity Build Result",
  "type": "object",
  "required": ["resourceBuildId", "workPackageCode", "complete", "materials", "tools", "missing"],
  "properties": {
    "resourceBuildId": {"type": "string"},
    "workPackageCode": {"type": "string"},
    "complete": {"type": "boolean"},
    "policyId": {"type": ["string", "null"]},
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "resourceId", "quantity", "unit", "costResponsibility", "status"],
        "properties": {
          "requirementId": {"type": "string"},
          "resourceId": {"type": "string"},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "unit": {"type": ["string", "null"]},
          "costResponsibility": {"enum": ["VIVUM", "CUSTOMER", "EXTERNAL"]},
          "status": {"enum": ["DERIVED", "NOT_DERIVED"]},
          "source": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "tools": {"type": "array"},
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "reason"],
        "properties": {
          "requirementId": {"type": "string"},
          "resourceId": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
