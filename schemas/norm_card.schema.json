{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivum.local/schemas/norm_card.schema.json",
  "title": "VIVUM Norm Card",
  "type": "object",
  "required": ["normCardId", "operationCode", "driver", "status", "version"],
  "properties": {
    "normCardId": {"type": "string"},
    "operationCode": {"type": "string", "pattern": "^EL-RI-[0-9]{3}-[0-9]{2}$"},
    "driver": {"type": "string"},
    "variantConditions": {"type": "object"},
    "sampleSize": {"type": "integer", "minimum": 0},
    "workerCount": {"type": "integer", "minimum": 0},
    "siteCount": {"type": "integer", "minimum": 0},
    "medianPersonMin": {"type": ["number", "null"], "minimum": 0},
    "recommendedPersonMin": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["TEST", "PRELIMINARY", "WORKING", "APPROVED", "RETIRED"]},
    "version": {"type": "integer", "minimum": 1},
    "approvedBy": {"type": ["string", "null"]},
    "approvedAt": {"type": ["string", "null"], "format": "date-time"},
    "sourceMeasurementIds": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
