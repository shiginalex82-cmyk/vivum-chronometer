{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivum.local/schemas/measurement_record.schema.json",
  "title": "VIVUM Chronometry Measurement Record",
  "type": "object",
  "required": ["measurementId", "workPackageCode", "workType", "worker", "crewSize", "qty1", "date", "prod", "loss", "stageTimes"],
  "properties": {
    "measurementId": {"type": "string", "minLength": 1},
    "workPackageCode": {"type": "string", "pattern": "^EL-RI-[0-9]{3}$"},
    "workKey": {"type": "string"},
    "workType": {"type": "string"},
    "packageName": {"type": "string"},
    "worker": {"type": "string"},
    "crewSize": {"type": "integer", "minimum": 1},
    "qty1": {"type": "number", "exclusiveMinimum": 0},
    "qty2": {"type": "number", "minimum": 0},
    "date": {"type": "string", "format": "date-time"},
    "prepAcceptedAt": {"type": "string", "format": "date-time"},
    "supplyPrepMin": {"type": "number", "minimum": 0},
    "engineerPrepMin": {"type": "number", "minimum": 0},
    "installerPrepMin": {"type": "number", "minimum": 0},
    "total": {"type": "number", "minimum": 0, "description": "elapsed ms"},
    "prod": {"type": "number", "minimum": 0, "description": "productive elapsed ms"},
    "loss": {"type": "number", "minimum": 0, "description": "loss elapsed ms"},
    "prodPersonMs": {"type": "number", "minimum": 0},
    "lossPersonMs": {"type": "number", "minimum": 0},
    "stageTimes": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "observationGroupTimes": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "pauses": {"type": "array", "items": {"type": "object", "required": ["reason", "ms"], "properties": {"reason": {"type": "string"}, "ms": {"type": "number", "minimum": 0}}}},
    "conditions": {"type": "string"},
    "baseMaterial": {"type": "string"},
    "cableType": {"type": "string"},
    "cableGroup": {"type": "string"},
    "comment": {"type": "string"},
    "catalogSchemaVersion": {"type": "string"},
    "appVersion": {"type": "string"}
  },
  "additionalProperties": true
}
