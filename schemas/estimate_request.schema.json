{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivum.local/schemas/estimate_request.schema.json",
  "title": "VIVUM Labor Estimate Request",
  "type": "object",
  "required": ["estimateId", "packages"],
  "properties": {
    "estimateId": {"type": "string", "minLength": 1},
    "project": {"type": "string"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workPackageCode", "drivers"],
        "properties": {
          "workPackageCode": {"type": "string", "pattern": "^EL-RI-[0-9]{3}$"},
          "drivers": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
          "prepPersonMin": {
            "type": "object",
            "properties": {
              "supply": {"type": "number", "minimum": 0},
              "engineer": {"type": "number", "minimum": 0},
              "installer": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "conditions": {"type": "object"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
